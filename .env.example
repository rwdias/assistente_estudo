# Variáveis usadas apenas em tarefas de MANUTENÇÃO local (migrações de
# schema, administração). O app em si não lê este arquivo: o front usa a
# anon key pública (web/js/config.js) e as chaves de IA vivem em
# `supabase secrets`.
#
# Copie para ".env" e preencha. O ".env" é git-ignorado.

# Senha do Postgres do projeto (Settings -> Database -> Reset password)
SUPABASE_DB_PASSWORD=

# Token pessoal para o CLI (Account -> Access Tokens)
SUPABASE_ACCESS_TOKEN=

# Chave service_role (Settings -> API Keys) — NUNCA no front nem em commit
SUPABASE_SERVICE_ROLE_KEY=

# Chaves de IA para configurar via `supabase secrets set --env-file`
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
XAI_API_KEY=
XAI_MODEL=grok-4.3
IA_QUOTA_DIARIA=20
