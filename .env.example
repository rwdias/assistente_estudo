# Copie este arquivo para ".env" e preencha as chaves dos provedores que for usar.
# Nenhum valor aqui é lido diretamente — este arquivo serve apenas de modelo e é versionado.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

XAI_API_KEY=
XAI_MODEL=grok-4.3

# Chave usada para assinar os tokens JWT de autenticação. Gere uma própria
# (ex.: `python -c "import secrets; print(secrets.token_hex(32))"`) e nunca
# reutilize o exemplo abaixo em produção.
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_EXPIRE_MINUTES=10080

# Quantas chamadas de IA (extração/reformulação) cada usuário pode fazer por
# dia — protege sua conta na OpenAI/Anthropic/xAI de uso excessivo por
# visitantes públicos.
IA_QUOTA_DIARIA=20
